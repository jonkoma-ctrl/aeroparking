generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CruiseReservation {
  id              String   @id @default(cuid())
  status          String   @default("pending") // pending | confirmed | cancelled

  // Datos del cliente
  firstName       String
  lastName        String
  email           String
  phone           String

  // Datos del viaje
  departureDate   DateTime
  arrivalTime     String   // Hora estimada de llegada al parking
  returnDate      DateTime
  pickupTime      String   // Hora estimada de retiro del auto
  passengers      Int

  // Datos del vehículo
  licensePlate    String
  carBrand        String
  carModel        String

  // Datos opcionales del crucero
  cruiseLine      String?  // Naviera
  terminal        String?

  // Observaciones
  notes           String?

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AeroparqueReservation {
  id               String   @id @default(cuid())
  externalOrderId  String   @unique
  status           String   @default("confirmed") // pending_payment | confirmed | checked_in | completed | cancelled | payment_rejected | payment_expired | payment_review

  destination      String   @default("aeroparque") // "aeroparque" | "puerto"
  serviceType      String   // "drop_go" | "larga_estadia"
  customerName     String
  email            String?
  phone            String?
  dni              String?

  // Vehículo
  licensePlate     String
  carBrand         String
  carModel         String

  // Reserva
  startDate        DateTime
  endDate          DateTime
  price            Int      // ARS pesos enteros (214000)

  // Vuelo
  departureFlightDate DateTime?
  departureAirline    String?
  departureFlight     String?
  arrivalAirline      String?
  arrivalFlight       String?
  arrivalTime         String?
  checkInTime         String?
  passengers          Int?

  // Crucero (destino puerto / serviceType cruceros)
  cruiseLine          String?
  terminal            String?

  // Notas
  notes            String?  @db.Text

  // QR + control de acceso (check-in/out en Costa Salguero)
  qrToken          String?  @unique  // código corto tipeable (6 chars) que va en el QR
  checkedInAt      DateTime?          // cuándo ingresó el auto a la sede
  checkedOutAt     DateTime?          // cuándo se retiró
  checkInBy        String?            // quién marcó el ingreso (personal)
  checkOutBy       String?            // quién marcó el retiro

  // Cobro online con Mercado Pago (cuenta de Border's Parking SRL).
  // Mientras status = "pending_payment" la reserva no cuenta en agenda,
  // vista del día ni escáner.
  mpPreferenceId   String?
  mpPaymentId      String?
  paidAmount       Int?
  paidAt           DateTime?
  paymentExpiresAt DateTime?

  // De dónde vino el cliente: gclid, gbraid, wbraid, fbclid y UTMs
  attribution      Json?

  // Google Analytics del navegador que reservó (sólo si no rechazó cookies):
  // con esto la compra que manda el servidor se une a la visita y al anuncio.
  gaClientId       String?            // de la cookie _ga ("X.Y")
  gaSessionId      String?            // de la cookie _ga_<id de la propiedad>
  purchaseSentAt   DateTime?          // cuándo el servidor mandó el "purchase" a GA4

  // Auditoría
  rawEmailSubject  String?  // DEPRECATED — legacy AA2000 webhook, sin uso desde may-2026
  rawEmailBody     String?  @db.Text   // DEPRECATED — legacy AA2000 webhook, sin uso desde may-2026

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Destination {
  id            String   @id @default(cuid())
  slug          String   @unique           // "aeroparque" | "ezeiza" | "puerto" | etc.
  label         String                     // "Aeroparque Jorge Newbery"
  shortLabel    String                     // "Aeroparque"
  iconKey       String   @default("plane") // "plane" | "ship" | "bus" — render-side
  accentColor   String   @default("blue")  // tailwind hue (blue, sky, violet, amber)
  description   String?  @db.Text
  addressInfo   String?  @db.Text          // instructivo para el cliente
  imageUrl      String?                    // URL Vercel Blob, imagen principal
  imageAlt      String?                    // alt text para accesibilidad
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active, sortOrder])
}

model SiteSettings {
  id              String   @id @default("singleton")
  heroImageUrl    String?
  heroImageAlt    String?
  heroTitle       String?  @db.Text
  heroSubtitle    String?  @db.Text
  whatsappPhone   String?
  contactEmail    String?
  // URL para que el cliente deje su review/reseña (Google Business, Trustpilot, etc.)
  reviewUrl       String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

model ServicePricing {
  id                  String   @id @default(cuid())
  destination         String   // "puerto" | "aeroparque" | "ezeiza"
  serviceType         String   // "larga_estadia" | "drop_go" | "cruceros" | "ezeiza_larga_estadia"
  pricePerDay         Int      // ARS pesos enteros por estadía completa (24h)
  description         String?
  active              Boolean  @default(true)
  isReference         Boolean  @default(false)  // DEPRECATED — legacy AA2000, sin uso desde may-2026
  externalCheckoutUrl String?                    // DEPRECATED — legacy AA2000, sin uso desde may-2026
  minDays             Int?
  maxDays             Int?
  durationDiscounts   Json?    // [{fromDays, pctOff}] — descuento % (legacy, opcional)
  // Grilla de precios por cantidad de días: [{days, price}] con precio ABSOLUTO
  // por tramo (ej: 1 día=$39k, 2 días=$70k, 3 días=$95k). Si está cargada,
  // tiene prioridad sobre el precio lineal (pricePerDay × días).
  priceTable          Json?    // [{days: number, price: number}]
  extraDayPrice       Int?     // precio por cada día adicional después del último tramo de la grilla
  transferIncluded    Boolean  @default(true)   // false → cobra traslado aparte (Ezeiza)
  transferCostPerLeg  Int?                       // ARS por tramo de traslado (solo si no incluido)
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  @@unique([destination, serviceType])
}

model CustomerCredit {
  id                  String    @id @default(cuid())
  email               String
  amountAvailable     Int       // ARS pesos
  reason              String?   @db.Text
  sourceReservationId String?   // reserva que originó el crédito (ej: cancelada por vuelo cancelado)
  status              String    @default("available")  // available | used | expired
  usedAt              DateTime?
  usedReservationId   String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([email, status])
}
